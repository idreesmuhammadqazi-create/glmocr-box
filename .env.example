# GLM-OCR / Z.ai credentials. Copy to .env and fill in.
# Either gateway works with the same key format:
#   CN:           https://open.bigmodel.cn/api/paas/v4
#   International: https://api.z.ai/api/paas/v4
ZAI_API_KEY=your-api-key-here
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_OCR_MODEL=glm-ocr

# Backend: "glm" (real API) or "mock" (offline, no key needed).
OCRQP_BACKEND=glm

# Rendering DPI for pass 1 (page) and pass 2 (table crops).
OCRQP_PAGE_DPI=200
OCRQP_TABLE_DPI=300

# Drop "image" elements smaller than this fraction of the page (filters logos).
OCRQP_MIN_FIGURE_AREA=0.015
